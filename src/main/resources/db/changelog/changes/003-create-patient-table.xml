<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="003-1-create-patient" author="proxymed">
        <createTable tableName="patient">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="numero_dossier_proxymed" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="numero_dmi" type="VARCHAR(100)">
                <constraints unique="true"/>
            </column>
            <column name="nom_complet" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="date_naissance" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="sexe" type="VARCHAR(1)">
                <constraints nullable="false"/>
            </column>
            <column name="telephone" type="VARCHAR(30)"/>
            <column name="adresse_domicile" type="VARCHAR(255)"/>
            <column name="commune" type="VARCHAR(255)"/>
            <column name="quartier" type="VARCHAR(255)"/>
            <column name="personne_a_contacter_nom" type="VARCHAR(255)"/>
            <column name="personne_a_contacter_telephone" type="VARCHAR(30)"/>
            <column name="couverture_sociale" type="VARCHAR(30)"/>
        </createTable>
    </changeSet>

    <changeSet id="003-2-index-patient-nom" author="proxymed">
        <createIndex indexName="idx_patient_nom_complet" tableName="patient">
            <column name="nom_complet"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
