<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="002-1-create-medecin" author="proxymed">
        <createTable tableName="medecin">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="prenom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="numero_ordre" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="role" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="structure_rattachement_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_medecin_structure" references="structure(id)"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
